{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rocksoul.dev/legend/schemas/artifact.schema.json",
  "title": "LEGEND Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "artifact_type",
    "culture",
    "date",
    "discovery",
    "repository",
    "registration",
    "summary",
    "source_refs",
    "uncertainty"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ART-[A-Z0-9][A-Z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "enum": [
        "votive_object",
        "ritual_object",
        "manuscript",
        "inscription",
        "tool",
        "weapon",
        "other"
      ]
    },
    "culture": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "precision"
      ],
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "range",
            "period",
            "unknown"
          ]
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "place_id",
        "note"
      ],
      "properties": {
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "place_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^PLC-[A-Z0-9][A-Z0-9-]*$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "registration": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
