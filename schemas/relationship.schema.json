{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rocksoul.dev/legend/schemas/relationship.schema.json",
  "title": "LEGEND Relationship Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject_id",
    "relation",
    "object_id",
    "status",
    "confidence",
    "source_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REL-[A-Z0-9][A-Z0-9-]*$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "enum": [
        "caused",
        "witnessed_by",
        "recorded_by",
        "participated_in",
        "located_at",
        "associated_with",
        "possibly_correlates_with",
        "chronologically_compatible_with",
        "geographically_compatible_with",
        "possibly_influenced",
        "remembered_as",
        "later_interpreted_as",
        "origin_of",
        "inspired",
        "attested_by"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "hypothesis",
        "supported",
        "disputed",
        "rejected"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
