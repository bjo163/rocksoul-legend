{
  "name": "rocksoul-legend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Historical & Event Intelligence for the Rocksoul Research ecosystem.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate.mjs",
    "index": "node scripts/build-index.mjs",
    "typecheck": "tsc --noEmit",
    "build:data": "npm run validate && npm run index",
    "build": "npm run build:data && npm run typecheck && vite build",
    "ci": "npm run build"
  },
  "dependencies": {
    "@rocksoul/ui": "github:bjo163/rocksoul-ui#main",
    "ajv": "^8.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.2"
  },
  "packageManager": "npm@11.6.0"
}
